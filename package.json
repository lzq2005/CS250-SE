{
  "name": "tripmate-macau",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @tripmate/api\" \"npm run dev -w @tripmate/web\"",
    "build": "npm run build -w @tripmate/contracts && npm run build -w @tripmate/api && npm run build -w @tripmate/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:setup": "node scripts/database.mjs",
    "db:seed:pois": "node --import tsx apps/api/src/cli/seed-pois.ts",
    "test:e2e:poi-integration": "playwright test --config playwright.poi-integration.config.ts",
    "start": "npm run start -w @tripmate/api",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "npm run build -w @tripmate/contracts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.5.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "dotenv": "^17.2.0"
  }
}
